# LOCFHR: high 32 bits.
:LOCFHRO RRFc_R1 "," RRFc_R2 is RRFc_OP=0xB9E0 & RRFc_M3=1 & RRFc_R1 & RRFc_R2
{
    local _c_m:1;
    local _c_bit:1;
    _c_m = 1;
    _c_bit = (cc3);
    if (_c_bit) goto <c_do>;
    goto <c_done>;
<c_do>
    RRFc_R1 = (RRFc_R1 & 0xFFFFFFFF) | (RRFc_R2 & (0xFFFFFFFF << 32));
<c_done>
}

