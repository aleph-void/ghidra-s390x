    local _c_m:1;
    local _c_bit:1;
    _c_m = RRFc_M3;
    cc_hit(_c_m, _c_bit);
    if (_c_bit) goto <c_do>;
    goto <c_done>;
<c_do>
    RRFc_R1 = (RRFc_R1 & (0xFFFFFFFF << 32)) | (RRFc_R2 & 0xFFFFFFFF);
<c_done>
}

