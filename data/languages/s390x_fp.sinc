# ---------------------------------------------------------------------------
# Condition-code helpers. cc_set (from s390x_arith.sinc) writes the 2-bit CC
# into the PSW byte. r/z/a/b are float varnodes; z is the all-zeros bit
# pattern of the same size (== +0.0).
# ---------------------------------------------------------------------------

# BFP arithmetic result -> CC: 0=zero, 1=negative, 2=positive, 3=NaN.
macro fp_cc_result(r, z) {
    local ncc:1;
    if (nan(r) != 0) goto <fpcc_nan>;
    if (r f== z) goto <fpcc_zero>;
    if (r f< z) goto <fpcc_neg>;
    ncc = 2;
    goto <fpcc_done>;
<fpcc_neg>
    ncc = 1;
    goto <fpcc_done>;
<fpcc_zero>
    ncc = 0;
    goto <fpcc_done>;
<fpcc_nan>
    ncc = 3;
<fpcc_done>
    cc_set(ncc);
}

# HFP arithmetic result -> CC (HFP has no NaN/Infinity): 0=zero,1=neg,2=pos.
macro fp_cc_hfp(r, z) {
    local ncc:1;
    if (r f== z) goto <fph_zero>;
    if (r f< z) goto <fph_neg>;
    ncc = 2;
    goto <fph_done>;
<fph_neg>
    ncc = 1;
    goto <fph_done>;
<fph_zero>
    ncc = 0;
<fph_done>
    cc_set(ncc);
}

# BFP compare -> CC: 0=equal, 1=a<b, 2=a>b, 3=unordered (NaN operand).
macro fp_cc_compare(a, b) {
    local ncc:1;
    if (nan(a) != 0) goto <fpcc_unordered>;
    if (nan(b) != 0) goto <fpcc_unordered>;
    if (a f== b) goto <fpcc_equal>;
    if (a f< b) goto <fpcc_low>;
    ncc = 2;
    goto <fpcc_cdone>;
<fpcc_low>
    ncc = 1;
    goto <fpcc_cdone>;
<fpcc_equal>
    ncc = 0;
    goto <fpcc_cdone>;
<fpcc_unordered>
    ncc = 3;
<fpcc_cdone>
    cc_set(ncc);
}

# HFP compare -> CC (no NaN in HFP): 0=equal, 1=a<b, 2=a>b.
macro fp_cc_compare_hfp(a, b) {
    local ncc:1;
    if (a f== b) goto <fphc_equal>;
    if (a f< b) goto <fphc_low>;
    ncc = 2;
    goto <fphc_done>;
<fphc_low>
    ncc = 1;
    goto <fphc_done>;
<fphc_equal>
    ncc = 0;
<fphc_done>
    cc_set(ncc);
}

