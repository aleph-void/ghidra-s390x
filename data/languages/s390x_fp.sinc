# ============================================================================
# s390x_fp.sinc — Floating-point instructions for the s390x SLEIGH spec.
#
# Covers the HFP (hexadecimal floating-point, PoP Ch. 18) and BFP
# (binary floating-point / IEEE-754, PoP Ch. 19) instruction groups that
# operate on the floating-point registers f0-f15:
#
#   Loads/stores/lengthening : LE LD LER LDR LDE LXD LXDR
#                              (BFP: LDEBR LXDBR)
#   HFP arithmetic           : AE AD AER ADR SE SD SER SDR
#                              MDE MD MDER MDR DE DD DER DDR
#   HFP compare              : CE CD CER CDR
#   BFP arithmetic (RXE/RRE) : AEB ADB SEB SDB MDEB MDB DEB DDB
#                              AEBR ADBR SEBR SDBR MDEBR MDBR DEBR DDBR
#   BFP compare              : CEB CDB CEBR CDBR
#   BFP sign/test            : LPEBR LNEBR LTEBR
#   BFP convert/round        : CEFBR CDFBR CEGBR CDGBR CELFBR CDLFBR
#                              FIEBR FIDBR FIXBR
#   HFP convert from fixed   : CEGR CDGR
#
# Inclusion: add the line
#     @include "s390x_fp.sinc"
# to data/languages/s390x.slaspec (after the other @include lines).
#
# Conventions and deliberate approximations:
# - A short (32-bit) FP datum occupies the LEFTMOST 32 bits of its 64-bit
#   FPR (PoP 9-8). The 4-byte aliases f0h-f15h overlay those high halves,
#   so short loads/writes leave the low 32 bits untouched, exactly like
#   hardware. Disassembly prints them as e.g. "f1h".
# - HFP is NOT IEEE-754. There is no HFP p-code operator, so HFP arithmetic
#   is modeled with the IEEE FLOAT_* operators as an approximation. Every
#   HFP arithmetic constructor carries a TODO. Dataflow (registers read /
#   written, CC set) is accurate; bit-level HFP semantics are not.
# - BFP arithmetic uses FLOAT_* directly (BFP == IEEE-754 binary32/64).
# - IEEE exception flags (inexact, overflow, underflow, invalid) and the
#   FPC rounding-mode/M3/M4 modifiers are NOT modeled; each affected
#   constructor carries an explicit TODO. CC is modeled per the PoP.
# - Extended-format (128-bit) targets use a single FPR attach for the
#   high-order 64 bits and OVER-ACCEPT the "valid register pair"
#   requirement (PoP 9-8: pairs are (0,2),(4,6),(8,10),(12,14),
#   (1,3),(5,7),(9,11),(13,15)). The low-order 64 bits (F(R1+2)) are not
#   modeled; each such constructor carries a TODO.
# - MDE/MDER/MDEB/MDEBR are short->long multiplies. The model computes the
#   short (32-bit) product into the high half (TODO notes the deviation:
#   hardware produces a 48-bit-exact long product).
# Reference: IBM z/Architecture Principles of Operation SA22-7832-14.
# ============================================================================

# 4-byte aliases for the HIGH halves of f0-f15 (big-endian: offset 0x0c0 is
# the most-significant end, so offset+0 is the high 32 bits where short
# FP data lives). Low 32 bits are never touched through these aliases.
define register offset=0x0c0 size=4 [
    f0h  _ _ _ f1h  _ _ _ f2h  _ _ _ f3h  _ _ _ f4h  _ _ _ f5h  _ _ _ f6h  _ _ _ f7h  _ _ _
    f8h  _ _ _ f9h  _ _ _ f10h _ _ _ f11h _ _ _ f12h _ _ _ f13h _ _ _ f14h _ _ _ f15h _ _ _
];

# ---------------------------------------------------------------------------
# Tokens. Bit numbering is SLEIGH LSB=0 (PoP numbers MSB=0); every field is
# converted as (N-1-e, N-1-s) for an N-bit token.
# ---------------------------------------------------------------------------

# RXs: RX-a (32b), R1 -> short-FP alias (fNh). Short HFP loads/arithmetic.
define token RXs(32)
    RXs_OP = (24,31)
    RXs_R1 = (20,23)
    RXs_X2 = (16,19)
    RXs_B2 = (12,15)
    RXs_D2 = (0,11)
;

# RXl: RX-a (32b), R1 -> full FPR. Long HFP loads/arithmetic.
define token RXl(32)
    RXl_OP = (24,31)
    RXl_R1 = (20,23)
    RXl_X2 = (16,19)
    RXl_B2 = (12,15)
    RXl_D2 = (0,11)
;

# RRs: RR (16b), R1/R2 -> short-FP aliases. Short HFP register ops.
define token RRs(16)
    RRs_OP = (8,15)
    RRs_R1 = (4,7)
    RRs_R2 = (0,3)
;

# RRl: RR (16b), R1/R2 -> full FPRs. Long HFP register ops.
define token RRl(16)
    RRl_OP = (8,15)
    RRl_R1 = (4,7)
    RRl_R2 = (0,3)
;

# RXEs: RXE (48b), R1 -> short-FP alias. Short BFP memory ops.
# PoP RXE: OP(0-7) R1(8-11) X2(12-15) B2(16-19) DL2(20-31) DH2(32-39) OP2(40-47).
define token RXEs(48)
    RXEs_OP  = (40,47)
    RXEs_R1  = (36,39)
    RXEs_X2  = (32,35)
    RXEs_B2  = (28,31)
    RXEs_DL2 = (16,27)
    RXEs_DH2 = (8,15)
    RXEs_OP2 = (0,7)
;

# RXEl: RXE (48b), R1 -> full FPR. Long BFP memory ops + HFP lengthening.
define token RXEl(48)
    RXEl_OP  = (40,47)
    RXEl_R1  = (36,39)
    RXEl_X2  = (32,35)
    RXEl_B2  = (28,31)
    RXEl_DL2 = (16,27)
    RXEl_DH2 = (8,15)
    RXEl_OP2 = (0,7)
;

# RREs: RRE (32b), R1/R2 -> short-FP aliases. Short BFP register ops.
define token RREs(32)
    RREs_OP  = (16,31)
    RREs_IGN = (8,15)
    RREs_R1  = (4,7)
    RREs_R2  = (0,3)
;

# RREsl: RRE (32b), R1 -> full FPR (long result), R2 -> short-FP alias.
# For MDEBR (short->long multiply) and LDEBR (short->long lengthen).
define token RREsl(32)
    RREsl_OP  = (16,31)
    RREsl_IGN = (8,15)
    RREsl_R1  = (4,7)
    RREsl_R2  = (0,3)
;

# RREl: RRE (32b), R1/R2 -> full FPRs. Long BFP register ops + long->extended.
define token RREl(32)
    RREl_OP  = (16,31)
    RREl_IGN = (8,15)
    RREl_R1  = (4,7)
    RREl_R2  = (0,3)
;

# RREg: RRE (32b), R1 -> GPR. FPC register ops (SFPC/EFPC use general
# registers per PoP 9-30/9-47, not FPRs).
define token RREg(32)
    RREg_OP  = (16,31)
    RREg_IGN = (8,15)
    RREg_R1  = (4,7)
    RREg_R2  = (0,3)
;

# RREsg: RRE (32b), R1 -> short-FP alias, R2 -> GPR. Convert fixed->short.
define token RREsg(32)
    RREsg_OP  = (16,31)
    RREsg_IGN = (8,15)
    RREsg_R1  = (4,7)
    RREsg_R2  = (0,3)
;

# RRElg: RRE (32b), R1 -> full FPR, R2 -> GPR. Convert fixed->long.
define token RRElg(32)
    RRElg_OP  = (16,31)
    RRElg_IGN = (8,15)
    RRElg_R1  = (4,7)
    RRElg_R2  = (0,3)
;

# RREfg: RRE (32b), R1 -> full FPR, R2 -> GPR. LDGR (load FPR from GR).
define token RREfg(32)
    RREfg_OP  = (16,31)
    RREfg_IGN = (8,15)
    RREfg_R1  = (4,7)
    RREfg_R2  = (0,3)
;

# RREgf: RRE (32b), R1 -> GPR, R2 -> full FPR. LGDR (load GR from FPR).
define token RREgf(32)
    RREgf_OP  = (16,31)
    RREgf_IGN = (8,15)
    RREgf_R1  = (4,7)
    RREgf_R2  = (0,3)
;

# RRFs: RRF-e (32b), R1/R2 -> short-FP aliases, M3/M4 modifiers.
# PoP RRF-e: OP(0-15) M3(16-19) M4(20-23) R1(24-27) R2(28-31).
define token RRFs(32)
    RRFs_OP = (16,31)
    RRFs_M3 = (12,15)
    RRFs_M4 = (8,11)
    RRFs_R1 = (4,7)
    RRFs_R2 = (0,3)
;

# RRFl: RRF-e (32b), R1/R2 -> full FPRs, M3/M4 modifiers.
define token RRFl(32)
    RRFl_OP = (16,31)
    RRFl_M3 = (12,15)
    RRFl_M4 = (8,11)
    RRFl_R1 = (4,7)
    RRFl_R2 = (0,3)
;

# RRFsg: RRF-e (32b), R1 -> short-FP alias, R2 -> GPR, M3/M4 modifiers.
define token RRFsg(32)
    RRFsg_OP = (16,31)
    RRFsg_M3 = (12,15)
    RRFsg_M4 = (8,11)
    RRFsg_R1 = (4,7)
    RRFsg_R2 = (0,3)
;

# RRFlg: RRF-e (32b), R1 -> full FPR, R2 -> GPR, M3/M4 modifiers.
define token RRFlg(32)
    RRFlg_OP = (16,31)
    RRFlg_M3 = (12,15)
    RRFlg_M4 = (8,11)
    RRFlg_R1 = (4,7)
    RRFlg_R2 = (0,3)
;

# ---------------------------------------------------------------------------
# Additional FP tokens: RRD, RXF, RRF-b (R3), RRF-e (GPR dest), RXY-a, DFP.
# ---------------------------------------------------------------------------

# RRDs/RRDl: RRD (32b) multiply-add/subtract. PoP Fig 5-1 (SA22-7832-14):
#   OP(0-15) R1(16-19) /(20-23) R3(24-27) R2(28-31).
# SLEIGH (N=32): OP=(16,31) R1=(12,15) IGN=(8,11) R3=(4,7) R2=(0,3).
# The reserved nibble must be 0 (Capstone rejects nonzero). Capstone prints
# operands in PoP order R1,R3,R2.
define token RRDs(32)
    RRDs_OP  = (16,31)
    RRDs_R1  = (12,15)
    RRDs_IGN = (8,11)
    RRDs_R3  = (4,7)
    RRDs_R2  = (0,3)
;

define token RRDl(32)
    RRDl_OP  = (16,31)
    RRDl_R1  = (12,15)
    RRDl_IGN = (8,11)
    RRDl_R3  = (4,7)
    RRDl_R2  = (0,3)
;

# RXFs: RXF (48b). PoP Fig 5-1: OP(0-7) R3(8-11) X2(12-15) B2(16-19)
#   D2(20-31) R1(32-35) /(36-39) OP2(40-47).
# SLEIGH (N=48): OP=(40,47) R3=(36,39) X2=(32,35) B2=(28,31) DL2=(16,27)
#   R1=(12,15) IGN=(8,11) OP2=(0,7).
# Used for HFP unnormalized multiply (ED38-ED3D, R1/R3 long) and DFP
# shift-significand (ED40/ED41/ED48/ED49, decode-only). The reserved nibble
# must be 0 (Capstone rejects nonzero).
define token RXFs(48)
    RXFs_OP  = (40,47)
    RXFs_R3  = (36,39)
    RXFs_X2  = (32,35)
    RXFs_B2  = (28,31)
    RXFs_DL2 = (16,27)
    RXFs_R1  = (12,15)
    RXFs_IGN = (8,11)
    RXFs_OP2 = (0,7)
;

# RXFl: RXF (48b), R1/R3 -> full FPR. Long BFP RXF multiply-add.
define token RXFl(48)
    RXFl_OP  = (40,47)
    RXFl_R3  = (36,39)
    RXFl_X2  = (32,35)
    RXFl_B2  = (28,31)
    RXFl_DL2 = (16,27)
    RXFl_R1  = (12,15)
    RXFl_IGN = (8,11)
    RXFl_OP2 = (0,7)
;

# RXFss: RXF (48b), R1/R3 -> short-FP alias. Short BFP RXF multiply-add.
define token RXFss(48)
    RXFss_OP  = (40,47)
    RXFss_R3  = (36,39)
    RXFss_X2  = (32,35)
    RXFss_B2  = (28,31)
    RXFss_DL2 = (16,27)
    RXFss_R1  = (12,15)
    RXFss_IGN = (8,11)
    RXFss_OP2 = (0,7)
;

# RRFbs/RRFbl: RRF-b (32b) with R3 (not M3) at bits 16-19, M4 at 20-23.
# SLEIGH: OP=(16,31) R3=(12,15) M4=(8,11) R1=(4,7) R2=(0,3).
# Used for DIEBR/DIDBR (M4 shown) and CPSDR (M4 nibble must be 0).
define token RRFbs(32)
    RRFbs_OP = (16,31)
    RRFbs_R3 = (12,15)
    RRFbs_M4 = (8,11)
    RRFbs_R1 = (4,7)
    RRFbs_R2 = (0,3)
;

define token RRFbl(32)
    RRFbl_OP = (16,31)
    RRFbl_R3 = (12,15)
    RRFbl_M4 = (8,11)
    RRFbl_R1 = (4,7)
    RRFbl_R2 = (0,3)
;

# RRFgs/RRFgl: RRF-e (32b), R1 -> GPR (destination), R2 -> FPR (source).
# For CONVERT TO FIXED / CONVERT TO LOGICAL (BFP/HFP -> integer).
define token RRFgs(32)
    RRFgs_OP = (16,31)
    RRFgs_M3 = (12,15)
    RRFgs_M4 = (8,11)
    RRFgs_R1 = (4,7)
    RRFgs_R2 = (0,3)
;

define token RRFgl(32)
    RRFgl_OP = (16,31)
    RRFgl_M3 = (12,15)
    RRFgl_M4 = (8,11)
    RRFgl_R1 = (4,7)
    RRFgl_R2 = (0,3)
;

# RXYFs/RXYFl: RXY-a (48b) for FP loads/stores. PoP Fig 5-1:
#   OP(0-7) R1(8-11) X2(12-15) B2(16-19) DL2(20-31) DH2(32-39) OP2(40-47).
# SLEIGH (N=48): OP=(40,47) R1=(36,39) X2=(32,35) B2=(28,31)
#   DL2=(16,27) DH2=(8,15) D20=(8,27) OP2=(0,7).
# D20 is the combined 20-bit displacement, displayed as hex. SLEIGH has no
# signed field display; negative displacements show as unsigned hex
# (e.g. 0xFF100 instead of Capstone's -0xF00). The p-code sign-extends
# correctly via ea_D20.
define token RXYFs(48)
    RXYFs_OP  = (40,47)
    RXYFs_R1  = (36,39)
    RXYFs_X2  = (32,35)
    RXYFs_B2  = (28,31)
    RXYFs_DL2 = (16,27)
    RXYFs_DH2 = (8,15)
    RXYFs_OP2 = (0,7)
;

define token RXYFl(48)
    RXYFl_OP  = (40,47)
    RXYFl_R1  = (36,39)
    RXYFl_X2  = (32,35)
    RXYFl_B2  = (28,31)
    RXYFl_DL2 = (16,27)
    RXYFl_DH2 = (8,15)
    RXYFl_OP2 = (0,7)
;

# DFP tokens (all decode-only; DFP values occupy full 64-bit FPRs).
# DFPab: RRF-a/b shape. OP=(16,31) R3=(12,15) M4=(8,11) R1=(4,7) R2=(0,3).
define token DFPab(32)
    DFPab_OP = (16,31)
    DFPab_R3 = (12,15)
    DFPab_M4 = (8,11)
    DFPab_R1 = (4,7)
    DFPab_R2 = (0,3)
;

# DFPd: RRF-d shape. OP=(16,31) M3=(12,15) M4=(8,11) R1=(4,7) R2=(0,3).
define token DFPd(32)
    DFPd_OP = (16,31)
    DFPd_M3 = (12,15)
    DFPd_M4 = (8,11)
    DFPd_R1 = (4,7)
    DFPd_R2 = (0,3)
;

# DFPe_ff/fr/rf: RRF-e shape with mixed FPR/GPR attachments.
define token DFPe_ff(32)
    DFPe_ff_OP = (16,31)
    DFPe_ff_M3 = (12,15)
    DFPe_ff_M4 = (8,11)
    DFPe_ff_R1 = (4,7)
    DFPe_ff_R2 = (0,3)
;

define token DFPe_fr(32)
    DFPe_fr_OP = (16,31)
    DFPe_fr_M3 = (12,15)
    DFPe_fr_M4 = (8,11)
    DFPe_fr_R1 = (4,7)
    DFPe_fr_R2 = (0,3)
;

define token DFPe_rf(32)
    DFPe_rf_OP = (16,31)
    DFPe_rf_M3 = (12,15)
    DFPe_rf_M4 = (8,11)
    DFPe_rf_R1 = (4,7)
    DFPe_rf_R2 = (0,3)
;

# DFPrr_ff/fr/rf: RRE shape with mixed attachments; M3/M4 split for A-forms.
define token DFPrr_ff(32)
    DFPrr_ff_OP  = (16,31)
    DFPrr_ff_IGN = (8,15)
    DFPrr_ff_R1  = (4,7)
    DFPrr_ff_R2  = (0,3)
;

define token DFPrr_fr(32)
    DFPrr_fr_OP = (16,31)
    DFPrr_fr_M3 = (12,15)
    DFPrr_fr_M4 = (8,11)
    DFPrr_fr_R1 = (4,7)
    DFPrr_fr_R2 = (0,3)
;

define token DFPrr_rf(32)
    DFPrr_rf_OP = (16,31)
    DFPrr_rf_M3 = (12,15)
    DFPrr_rf_M4 = (8,11)
    DFPrr_rf_R1 = (4,7)
    DFPrr_rf_R2 = (0,3)
;

# RREls: RRE (32b), R1 -> short FPR (high half), R2 -> full FPR.
# For LOAD ROUNDED (long BFP -> short BFP).
define token RREls(32)
    RREls_OP  = (16,31)
    RREls_IGN = (8,15)
    RREls_R1  = (4,7)
    RREls_R2  = (0,3)
;

# RRFsl: RRF-e (32b), R1 -> short FPR, R2 -> full FPR, M3/M4 modifiers.
# For LOAD ROUNDED (long BFP -> short BFP) A-form.
define token RRFsl(32)
    RRFsl_OP = (16,31)
    RRFsl_M3 = (12,15)
    RRFsl_M4 = (8,11)
    RRFsl_R1 = (4,7)
    RRFsl_R2 = (0,3)
;

# ---------------------------------------------------------------------------
# Attachments.
# ---------------------------------------------------------------------------
attach variables [ RXs_R1 ] [ f0h f1h f2h f3h f4h f5h f6h f7h f8h f9h f10h f11h f12h f13h f14h f15h ];
attach variables [ RXs_X2 ] [ zero r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 ];
attach variables [ RXs_B2 ] [ zero r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 ];
attach variables [ RXl_R1 ] [ f0 f1 f2 f3 f4 f5 f6 f7 f8 f9 f10 f11 f12 f13 f14 f15 ];
attach variables [ RXl_X2 ] [ zero r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 ];
attach variables [ RXl_B2 ] [ zero r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 ];
attach variables [ RRs_R1 ] [ f0h f1h f2h f3h f4h f5h f6h f7h f8h f9h f10h f11h f12h f13h f14h f15h ];
attach variables [ RRs_R2 ] [ f0h f1h f2h f3h f4h f5h f6h f7h f8h f9h f10h f11h f12h f13h f14h f15h ];
attach variables [ RRl_R1 ] [ f0 f1 f2 f3 f4 f5 f6 f7 f8 f9 f10 f11 f12 f13 f14 f15 ];
attach variables [ RRl_R2 ] [ f0 f1 f2 f3 f4 f5 f6 f7 f8 f9 f10 f11 f12 f13 f14 f15 ];
attach variables [ RXEs_R1 ] [ f0h f1h f2h f3h f4h f5h f6h f7h f8h f9h f10h f11h f12h f13h f14h f15h ];
attach variables [ RXEs_X2 ] [ zero r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 ];
attach variables [ RXEs_B2 ] [ zero r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 ];
attach variables [ RXEl_R1 ] [ f0 f1 f2 f3 f4 f5 f6 f7 f8 f9 f10 f11 f12 f13 f14 f15 ];
attach variables [ RXEl_X2 ] [ zero r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 ];
attach variables [ RXEl_B2 ] [ zero r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 ];
attach variables [ RREs_R1 ] [ f0h f1h f2h f3h f4h f5h f6h f7h f8h f9h f10h f11h f12h f13h f14h f15h ];
attach variables [ RREs_R2 ] [ f0h f1h f2h f3h f4h f5h f6h f7h f8h f9h f10h f11h f12h f13h f14h f15h ];
attach variables [ RREsl_R1 ] [ f0 f1 f2 f3 f4 f5 f6 f7 f8 f9 f10 f11 f12 f13 f14 f15 ];
attach variables [ RREsl_R2 ] [ f0h f1h f2h f3h f4h f5h f6h f7h f8h f9h f10h f11h f12h f13h f14h f15h ];
attach variables [ RREl_R1 ] [ f0 f1 f2 f3 f4 f5 f6 f7 f8 f9 f10 f11 f12 f13 f14 f15 ];
attach variables [ RREl_R2 ] [ f0 f1 f2 f3 f4 f5 f6 f7 f8 f9 f10 f11 f12 f13 f14 f15 ];
attach variables [ RREg_R1 ] [ r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 ];
attach variables [ RREsg_R1 ] [ f0h f1h f2h f3h f4h f5h f6h f7h f8h f9h f10h f11h f12h f13h f14h f15h ];
attach variables [ RREsg_R2 ] [ r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 ];
attach variables [ RRElg_R1 ] [ f0 f1 f2 f3 f4 f5 f6 f7 f8 f9 f10 f11 f12 f13 f14 f15 ];
attach variables [ RRElg_R2 ] [ r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 ];
attach variables [ RREfg_R1 ] [ f0 f1 f2 f3 f4 f5 f6 f7 f8 f9 f10 f11 f12 f13 f14 f15 ];
attach variables [ RREfg_R2 ] [ r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 ];
attach variables [ RREgf_R1 ] [ r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 ];
attach variables [ RREgf_R2 ] [ f0 f1 f2 f3 f4 f5 f6 f7 f8 f9 f10 f11 f12 f13 f14 f15 ];
