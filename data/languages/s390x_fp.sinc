# ============================================================================
# HFP RXF (ED): MULTIPLY UNNORMALIZED (storage). PoP 9-9.
#   MAY/MY:   R1(pair) = R1 + R3 * *ea (entire extended product).
#   MAYH/MYH: R1 = R1 + high(R3 * *ea).
#   MAYL/MYL: R1+1 = R1 + low(R3 * *ea) -- decode-only (low half not modeled).
# CC unchanged. The reserved nibble must be 0.
# TODO: HFP approx. The multiply-then-add is not fused (hardware does a
#   single rounding); modeled as separate IEEE multiply and add.
# ============================================================================

# display-only address operand (tools/fix_display.py)
dxb_RXFs_DL2_RXFs_X2_RXFs_B2: RXFs_DL2 is RXFs_DL2 & RXFs_X2=0 & RXFs_B2=0  { }
dxb_RXFs_DL2_RXFs_X2_RXFs_B2: RXFs_DL2(RXFs_B2) is RXFs_DL2 & RXFs_X2=0 & RXFs_B2  { }
dxb_RXFs_DL2_RXFs_X2_RXFs_B2: RXFs_DL2(RXFs_X2,0) is RXFs_DL2 & RXFs_X2 & RXFs_B2=0  { }
dxb_RXFs_DL2_RXFs_X2_RXFs_B2: RXFs_DL2(RXFs_X2,RXFs_B2) is RXFs_DL2 & RXFs_X2 & RXFs_B2  { }
:MAYH RXFs_R1 "," RXFs_R3 "," dxb_RXFs_DL2_RXFs_X2_RXFs_B2 is RXFs_OP=0xED & RXFs_OP2=0x3C & RXFs_IGN=0 & RXFs_R1 & RXFs_R3 & RXFs_X2 & RXFs_B2 & RXFs_DL2 & dxb_RXFs_DL2_RXFs_X2_RXFs_B2
{
    # MULTIPLY AND ADD UNNORMALIZED, high half: R1 = R1 + R3 * *ea.
    local ea:8; local p:8;
    ea_D12(ea, RXFs_B2, RXFs_X2, RXFs_DL2);
    p = RXFs_R3 f* *:8 ea;
    RXFs_R1 = RXFs_R1 f+ p;
}

:MYH RXFs_R1 "," RXFs_R3 "," dxb_RXFs_DL2_RXFs_X2_RXFs_B2 is RXFs_OP=0xED & RXFs_OP2=0x3D & RXFs_IGN=0 & RXFs_R1 & RXFs_R3 & RXFs_X2 & RXFs_B2 & RXFs_DL2 & dxb_RXFs_DL2_RXFs_X2_RXFs_B2
{
    # MULTIPLY UNNORMALIZED, high half: R1 = R3 * *ea.
    local ea:8;
    ea_D12(ea, RXFs_B2, RXFs_X2, RXFs_DL2);
    RXFs_R1 = RXFs_R3 f* *:8 ea;
}

:MAY RXFs_R1 "," RXFs_R3 "," dxb_RXFs_DL2_RXFs_X2_RXFs_B2 is RXFs_OP=0xED & RXFs_OP2=0x3A & RXFs_IGN=0 & RXFs_R1 & RXFs_R3 & RXFs_X2 & RXFs_B2 & RXFs_DL2 & dxb_RXFs_DL2_RXFs_X2_RXFs_B2
{
    # MULTIPLY AND ADD UNNORMALIZED (entire extended product).
    # TODO: only the high-order 64 bits are modeled (R1); the low-order
    #   64 bits of the pair are not. HFP approx, not fused.
    local ea:8; local p:8;
    ea_D12(ea, RXFs_B2, RXFs_X2, RXFs_DL2);
    p = RXFs_R3 f* *:8 ea;
    RXFs_R1 = RXFs_R1 f+ p;
}

:MY RXFs_R1 "," RXFs_R3 "," dxb_RXFs_DL2_RXFs_X2_RXFs_B2 is RXFs_OP=0xED & RXFs_OP2=0x3B & RXFs_IGN=0 & RXFs_R1 & RXFs_R3 & RXFs_X2 & RXFs_B2 & RXFs_DL2 & dxb_RXFs_DL2_RXFs_X2_RXFs_B2
{
    # MULTIPLY UNNORMALIZED (entire extended product).
    # TODO: only the high-order 64 bits are modeled (R1); the low-order
    #   64 bits of the pair are not. HFP approx.
    local ea:8;
    ea_D12(ea, RXFs_B2, RXFs_X2, RXFs_DL2);
    RXFs_R1 = RXFs_R3 f* *:8 ea;
}

:MAYL RXFs_R1 "," RXFs_R3 "," dxb_RXFs_DL2_RXFs_X2_RXFs_B2 is RXFs_OP=0xED & RXFs_OP2=0x38 & RXFs_IGN=0 & RXFs_R1 & RXFs_R3 & RXFs_X2 & RXFs_B2 & RXFs_DL2 & dxb_RXFs_DL2_RXFs_X2_RXFs_B2
{
    # MULTIPLY AND ADD UNNORMALIZED, low half (R1+1 = R1 + low(R3 * *ea)):
    # intentionally decode-only. The project models HFP values as IEEE
    # doubles, so the low 64 bits of the extended product lie below the
    # precision of the approximation -- no honest value can be
    # materialized, and any stored value would be fabrication. R1+1 is
    # left unchanged in the model.
}

:MYL RXFs_R1 "," RXFs_R3 "," dxb_RXFs_DL2_RXFs_X2_RXFs_B2 is RXFs_OP=0xED & RXFs_OP2=0x39 & RXFs_IGN=0 & RXFs_R1 & RXFs_R3 & RXFs_X2 & RXFs_B2 & RXFs_DL2 & dxb_RXFs_DL2_RXFs_X2_RXFs_B2
{
    # MULTIPLY UNNORMALIZED, low half (R1+1 = low(R3 * *ea)):
    # intentionally decode-only, same rationale as MAYL above.
}

