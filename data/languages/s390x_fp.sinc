dxb_RXYFs_D20_RXYFs_X2_RXYFs_B2: dispRXYFs_DL2 is RXYFs_DL2 & RXYFs_DH2 & RXYFs_X2=0 & RXYFs_B2=0 [ dispRXYFs_DL2 = ((RXYFs_DH2 << 12) | RXYFs_DL2) - (((RXYFs_DH2 >> 7) & 1) << 20); ] { }
