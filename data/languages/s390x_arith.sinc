# s390x_arith.sinc — arithmetic / logical / shift / rotate / compare / TM
# constructors for the IBM z/Architecture (s390x) SLEIGH processor module.
#
# @included by data/languages/s390x.slaspec after the shared definitions.
# Follows
# CONVENTIONS.md exactly (UPPERCASE fields, lowercase registers,
# ea_D12/ea_D20 macros, cc register).
#
# VERIFICATION (do not weaken without re-verifying):
#   * Every opcode/format below was taken from IBM z/Architecture Principles
#     of Operation SA22-7832-14, Appendix B "Instructions Arranged by
#     Operation Code", and cross-checked against the per-instruction format
#     diagrams and "Resulting Condition Code" text in Chapter 7.
#   * Every byte pattern was additionally decoded with Capstone 5.0.7
#     (CS_ARCH_SYSZ); 69/69 vectors decode to the expected mnemonic with the
#     expected length (see /tmp/pop/validate_vectors.py).
#   * Corrections found during verification (i.e. why you must not trust
#     memory): NG/OG/XG are E3 80/81/82 (NOT E3 14/16/17); NGR/OGR/XGR are
#     B9 80/81/82 (NOT B9 14/16/17); CHI/CGHI are A7 E/F (NOT A7 D/C);
#     CHY is E3 79 (NOT E3 75); MS is 0x71 RX-a (no EB 51 collision with TMY);
#     32-bit shifts exist as RS-a (88-8B: SRL/SLL/SRA/SLA) AND as RSY-a
#     K-variants (EB DC/DD/DE/DF, distinct-operands facility, R1=dest/R3=src).
#
# DISPLAYLIMIT (cosmetic only — decode and pcode use the full fields):
#   RXY/RSY/SIY constructors print only the low 12 displacement bits
#   ($(DL2)); the high 8 bits ($(DH2)) are omitted from the listing text.
#   B2=0/X2=0 print as the pseudo-register name "zero".
# (RIa token is defined once in s390x_loadstore.sinc; do not redefine it here.)

define token SIYd(48)
    SIYd_OP = (40,47)
    SIYd_I2 = (32,39)
    SIYd_B1 = (28,31)
    SIYd_DL1 = (16,27)
    SIYd_DH1 = (8,15)
    SIYd_OP2 = (0,7)
;
attach variables [ SIYd_B1 ] [ zero r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 ];

# ---------------------------------------------------------------------------
# Condition-code helper macros.
# The 'cc' register is a byte varnode holding the condition code as a
# plain 0-3 value (no bit packing). All arithmetic macros take 8-byte
# low-order bits hold the operand/result; sa/sb/sr are 0/1 sign bits.
# ---------------------------------------------------------------------------

macro cc_set(ncc) {
    cc = ncc; cc_sync();
}

# Shared tail for ADD/SUBTRACT: ov (0/1), sr = result sign (0/1),
# r = result varnode (zero-test on the full varnode).
macro cc_ov_tail(r, sr, ov) {
    local ncc:1;
        if (ov != 1) goto <if_1_else>;
 ncc = 3; 
    goto <if_1_end>;
    <if_1_else>

                if (r != 0) goto <if_2_else>;
 ncc = 0; 
        goto <if_2_end>;
        <if_2_else>

                        if (sr != 1) goto <if_3_else>;
 ncc = 1; 
            goto <if_3_end>;
            <if_3_else>
 ncc = 2; 
            <if_3_end>
        
        <if_2_end>
    
    <if_1_end>
    cc_set(ncc);
}

# Signed ADD: overflow iff the operand signs agree and the result sign differs.
macro cc_add32(r, sa, sb) {
    local sr:8;
    local ov:1;
    sr = (r >> 31) & 1;
    ov = 0;
        if (sa != sb) goto <if_4_end>;

                if (sr == sa) goto <if_5_end>;
 ov = 1; 
        <if_5_end>
    
    <if_4_end>
    cc_ov_tail(r, sr, ov);
}

macro cc_add64(r, sa, sb) {
    local sr:8;
    local ov:1;
    sr = (r >> 63) & 1;
    ov = 0;
        if (sa != sb) goto <if_6_end>;

                if (sr == sa) goto <if_7_end>;
 ov = 1; 
        <if_7_end>
    
    <if_6_end>
    cc_ov_tail(r, sr, ov);
}

# Signed SUBTRACT: overflow iff the operand signs differ and the result sign
# differs from the first operand's sign.
macro cc_sub32(r, sa, sb) {
    local sr:8;
    local ov:1;
    sr = (r >> 31) & 1;
    ov = 0;
        if (sa == sb) goto <if_8_end>;

                if (sr == sa) goto <if_9_end>;
 ov = 1; 
        <if_9_end>
    
    <if_8_end>
    cc_ov_tail(r, sr, ov);
}

macro cc_sub64(r, sa, sb) {
    local sr:8;
    local ov:1;
    sr = (r >> 63) & 1;
    ov = 0;
        if (sa == sb) goto <if_10_end>;

                if (sr == sa) goto <if_11_end>;
 ov = 1; 
        <if_11_end>
    
    <if_10_end>
    cc_ov_tail(r, sr, ov);
}

# AND/OR/XOR (register and SS forms): 0 = result zero, 1 = result not zero.
macro cc_logic(r) {
    local ncc:1;
        if (r != 0) goto <if_12_else>;
 ncc = 0; 
    goto <if_12_end>;
    <if_12_else>
 ncc = 1; 
    <if_12_end>
    cc_set(ncc);
}

# Signed COMPARE: 0 = equal, 1 = first low, 2 = first high. Callers mask a/b
# to the operand width first so the unsigned '<' below is valid when signs
# are equal.
macro cc_scmp32(a, b) {
    local sa:8;
    local sb:8;
    local ncc:1;
    sa = (a >> 31) & 1;
    sb = (b >> 31) & 1;
        if (a != b) goto <if_13_else>;
 ncc = 0; 
    goto <if_13_end>;
    <if_13_else>

                if (sa != sb) goto <if_14_else>;

                        if (!(a < b)) goto <if_15_else>;
 ncc = 1; 
            goto <if_15_end>;
            <if_15_else>
 ncc = 2; 
            <if_15_end>
        
        goto <if_14_end>;
        <if_14_else>

                        if (sa != 1) goto <if_16_else>;
 ncc = 1; 
            goto <if_16_end>;
            <if_16_else>
 ncc = 2; 
            <if_16_end>
        
        <if_14_end>
    
    <if_13_end>
    cc_set(ncc);
}

macro cc_scmp64(a, b) {
    local sa:8;
    local sb:8;
    local ncc:1;
    sa = (a >> 63) & 1;
    sb = (b >> 63) & 1;
        if (a != b) goto <if_17_else>;
 ncc = 0; 
    goto <if_17_end>;
    <if_17_else>

                if (sa != sb) goto <if_18_else>;

                        if (!(a < b)) goto <if_19_else>;
 ncc = 1; 
            goto <if_19_end>;
            <if_19_else>
 ncc = 2; 
            <if_19_end>
        
        goto <if_18_end>;
        <if_18_else>

                        if (sa != 1) goto <if_20_else>;
 ncc = 1; 
            goto <if_20_end>;
            <if_20_else>
 ncc = 2; 
            <if_20_end>
        
        <if_18_end>
    
    <if_17_end>
    cc_set(ncc);
}

# Unsigned COMPARE: 0 = equal, 1 = first low, 2 = first high.
macro cc_ucmp(a, b) {
    local ncc:1;
        if (a != b) goto <if_21_else>;
 ncc = 0; 
    goto <if_21_end>;
    <if_21_else>

                if (!(a < b)) goto <if_22_else>;
 ncc = 1; 
        goto <if_22_end>;
        <if_22_else>
 ncc = 2; 
        <if_22_end>
    
    <if_21_end>
    cc_set(ncc);
}

# TEST UNDER MASK: 0 = selected bits all zero (or mask zero),
# 1 = mixed, 3 = selected bits all one.
macro cc_tm(r, mask) {
    local ncc:1;
        if (r != 0) goto <if_23_else>;
 ncc = 0; 
    goto <if_23_end>;
    <if_23_else>

                if (r != mask) goto <if_24_else>;
 ncc = 3; 
        goto <if_24_end>;
        <if_24_else>
 ncc = 1; 
        <if_24_end>
    
    <if_23_end>
    cc_set(ncc);
}

# TEST UNDER MASK HIGH/LOW, 16-bit field variant (PoP 7-460/7-461): the
# mixed case distinguishes the leftmost bit of the tested 16-bit field
# (field's MSB = leftmost bit of the register field under test):
# 0 = selected bits all zero (or mask zero),
# 1 = mixed, leftmost bit of the field is zero,
# 2 = mixed, leftmost bit of the field is one,
# 3 = selected bits all one.
# Do NOT use for the byte forms (TM/TMY): those have no CC=2.
macro cc_tm16(field, r, mask) {
    local ncc:1;
    if (r != 0) goto <tm16_else>;
 ncc = 0;
    goto <tm16_end>;
    <tm16_else>
    if (r != mask) goto <tm16_mixed>;
 ncc = 3;
    goto <tm16_end>;
    <tm16_mixed>
    if ((field & 0x8000) != 0) goto <tm16_leftone>;
 ncc = 1;
    goto <tm16_end>;
    <tm16_leftone>
 ncc = 2;
    <tm16_end>
    cc_set(ncc);
}

# ===========================================================================
# ADD, 32-bit. Result -> bits 32-63 of R1; bits 0-31 of R1 unchanged.
# CC: 0 = zero, 1 = <0, 2 = >0, 3 = overflow (PoP 7-26).
# ===========================================================================

# AR: generated in s390x_table_gen.sinc (tools/gen_semantics.py)

# A: generated in s390x_table_gen.sinc (tools/gen_semantics.py)

# AH: generated in s390x_table_gen.sinc (tools/gen_semantics.py)

# AHY: generated in s390x_table_gen.sinc (tools/gen_semantics.py)

# AHI: generated in s390x_table_gen.sinc (tools/gen_semantics.py)

# AFI: generated in s390x_table_gen.sinc (tools/gen_semantics.py)

# ===========================================================================
# ADD, 64-bit. Full-register result. CC as above (PoP 7-26).
# ===========================================================================

# AGR: generated in s390x_table_gen.sinc (tools/gen_semantics.py)

# AG: generated in s390x_table_gen.sinc (tools/gen_semantics.py)

# AGHI: generated in s390x_table_gen.sinc (tools/gen_semantics.py)

# AGFI: generated in s390x_table_gen.sinc (tools/gen_semantics.py)

# ===========================================================================
# SUBTRACT, 32-bit and 64-bit. CC: 0 = zero, 1 = <0, 2 = >0, 3 = overflow
# (PoP 7-453/7-454).
# ===========================================================================

# SR: generated in s390x_table_gen.sinc (tools/gen_semantics.py)

# S: generated in s390x_table_gen.sinc (tools/gen_semantics.py)

# SH: generated in s390x_table_gen.sinc (tools/gen_semantics.py)

# SHY: generated in s390x_table_gen.sinc (tools/gen_semantics.py)

# SGR: generated in s390x_table_gen.sinc (tools/gen_semantics.py)

# SG: generated in s390x_table_gen.sinc (tools/gen_semantics.py)

# ===========================================================================
# AND. CC: 0 = result zero, 1 = result not zero (PoP 7-33).
# ===========================================================================

# NR: generated in s390x_table_gen.sinc (tools/gen_semantics.py)

# N: generated in s390x_table_gen.sinc (tools/gen_semantics.py)

# NY: generated in s390x_table_gen.sinc (tools/gen_semantics.py)

# NGR: generated in s390x_table_gen.sinc (tools/gen_semantics.py)

# NG: generated in s390x_table_gen.sinc (tools/gen_semantics.py)

# NI: generated in s390x_table_gen.sinc (tools/gen_semantics.py)

:NC dlb_SSa_D1_SSa_L_SSa_B1 "," db_SSa_D2_SSa_B2 is SSa_OP=0xD4 & SSa_L & SSa_B1 & SSa_D1 & SSa_B2 & SSa_D2 & dlb_SSa_D1_SSa_L_SSa_B1 & db_SSa_D2_SSa_B2
{
    local ea1:8;
    local ea2:8;
    local len:8;
    local a:1;
    local b:1;
    local r:1;
    local allzero:1;
    local ncc:1;
    ea_D12(ea1, SSa_B1, zero, SSa_D1);
    ea_D12(ea2, SSa_B2, zero, SSa_D2);
    local _ext1_ssa_l:1; _ext1_ssa_l = SSa_L;
    len = zext(_ext1_ssa_l) + 1;
    allzero = 1;
        <loop_1_start>
    if (len == 0) goto <loop_1_end>;

    a = *:1 (ea1);
    b = *:1 (ea2);
    r = a & b;
    *:1 ea1 = r;
        if (r == 0) goto <if_25_end>;
 allzero = 0; 
    <if_25_end>
    ea1 = ea1 + 1;
    ea2 = ea2 + 1;
    len = len - 1;

    goto <loop_1_start>;
    <loop_1_end>
        if (allzero != 1) goto <if_26_else>;
 ncc = 0; 
    goto <if_26_end>;
    <if_26_else>
 ncc = 1; 
    <if_26_end>
    cc_set(ncc);
}

# ===========================================================================
# OR. CC: 0 = result zero, 1 = result not zero (PoP 7-353).
# ===========================================================================

# OR: generated in s390x_table_gen.sinc (tools/gen_semantics.py)

# O: generated in s390x_table_gen.sinc (tools/gen_semantics.py)

# OY: generated in s390x_table_gen.sinc (tools/gen_semantics.py)

# OGR: generated in s390x_table_gen.sinc (tools/gen_semantics.py)

# OG: generated in s390x_table_gen.sinc (tools/gen_semantics.py)

# OI: generated in s390x_table_gen.sinc (tools/gen_semantics.py)

:OC dlb_SSa_D1_SSa_L_SSa_B1 "," db_SSa_D2_SSa_B2 is SSa_OP=0xD6 & SSa_L & SSa_B1 & SSa_D1 & SSa_B2 & SSa_D2 & dlb_SSa_D1_SSa_L_SSa_B1 & db_SSa_D2_SSa_B2
{
    local ea1:8;
    local ea2:8;
    local len:8;
    local a:1;
    local b:1;
    local r:1;
    local allzero:1;
    local ncc:1;
    ea_D12(ea1, SSa_B1, zero, SSa_D1);
    ea_D12(ea2, SSa_B2, zero, SSa_D2);
    local _ext2_ssa_l:1; _ext2_ssa_l = SSa_L;
    len = zext(_ext2_ssa_l) + 1;
    allzero = 1;
        <loop_2_start>
    if (len == 0) goto <loop_2_end>;

    a = *:1 (ea1);
    b = *:1 (ea2);
    r = a | b;
    *:1 ea1 = r;
        if (r == 0) goto <if_27_end>;
 allzero = 0; 
    <if_27_end>
    ea1 = ea1 + 1;
    ea2 = ea2 + 1;
    len = len - 1;

    goto <loop_2_start>;
    <loop_2_end>
        if (allzero != 1) goto <if_28_else>;
 ncc = 0; 
    goto <if_28_end>;
    <if_28_else>
 ncc = 1; 
    <if_28_end>
    cc_set(ncc);
}

# ===========================================================================
# EXCLUSIVE OR. CC: 0 = result zero, 1 = result not zero (PoP 7-292).
# ===========================================================================

# XR: generated in s390x_table_gen.sinc (tools/gen_semantics.py)

# X: generated in s390x_table_gen.sinc (tools/gen_semantics.py)

# XY: generated in s390x_table_gen.sinc (tools/gen_semantics.py)

# XGR: generated in s390x_table_gen.sinc (tools/gen_semantics.py)

# XG: generated in s390x_table_gen.sinc (tools/gen_semantics.py)

# XI: generated in s390x_table_gen.sinc (tools/gen_semantics.py)

:XC dlb_SSa_D1_SSa_L_SSa_B1 "," db_SSa_D2_SSa_B2 is SSa_OP=0xD7 & SSa_L & SSa_B1 & SSa_D1 & SSa_B2 & SSa_D2 & dlb_SSa_D1_SSa_L_SSa_B1 & db_SSa_D2_SSa_B2
{
    local ea1:8;
    local ea2:8;
    local len:8;
    local a:1;
    local b:1;
    local r:1;
    local allzero:1;
    local ncc:1;
    ea_D12(ea1, SSa_B1, zero, SSa_D1);
    ea_D12(ea2, SSa_B2, zero, SSa_D2);
    local _ext3_ssa_l:1; _ext3_ssa_l = SSa_L;
    len = zext(_ext3_ssa_l) + 1;
    allzero = 1;
        <loop_3_start>
    if (len == 0) goto <loop_3_end>;

    a = *:1 (ea1);
    b = *:1 (ea2);
    r = a ^ b;
    *:1 ea1 = r;
        if (r == 0) goto <if_29_end>;
 allzero = 0; 
    <if_29_end>
    ea1 = ea1 + 1;
    ea2 = ea2 + 1;
    len = len - 1;

    goto <loop_3_start>;
    <loop_3_end>
        if (allzero != 1) goto <if_30_else>;
 ncc = 0; 
    goto <if_30_end>;
    <if_30_else>
 ncc = 1; 
    <if_30_end>
    cc_set(ncc);
}

# ===========================================================================
# Shift cores. a = operand (8-byte varnode, only the low w bits significant),
# amt = shift count (0..63). Sets r = result (low w bits) and ncc.
# SLA/SLAG: sign bit preserved; overflow iff a bit unlike the sign is shifted
#   out of the top numeric-bit position (PoP 7-439).
# SRA/SRAG: sign bit preserved; vacated bits filled with the sign
#   (PoP 7-441). No overflow possible.
# ===========================================================================

macro sla_core32(a, amt, r, ncc) {
    local sa:8;
    local num:8;
    local rnum:8;
    local out:8;
    local one:8;
    local allones:8;
    local ov:1;
    sa = (a >> 31) & 1;
    num = a & 0x7fffffff;
    ov = 0;
    one = 1;
        if (amt != 0) goto <if_31_else>;

        rnum = num;
    
    goto <if_31_end>;
    <if_31_else>

                if (!(amt > 30)) goto <if_32_else>;

            # Entire 31-bit numeric part shifted out (PoP 7-438, note 3).
            rnum = 0;
                        if (sa != 0) goto <if_33_else>;

                                if (num == 0) goto <if_34_end>;
 ov = 1; 
                <if_34_end>
            
            goto <if_33_end>;
            <if_33_else>

                                if (num == 0x7fffffff) goto <if_35_end>;
 ov = 1; 
                <if_35_end>
            
            <if_33_end>
        
        goto <if_32_end>;
        <if_32_else>

            out = num >> (31 - amt);
            rnum = (num << amt) & 0x7fffffff;
            allones = (one << amt) - one;
                        if (sa != 0) goto <if_36_else>;

                                if (out == 0) goto <if_37_end>;
 ov = 1; 
                <if_37_end>
            
            goto <if_36_end>;
            <if_36_else>

                                if (out == allones) goto <if_38_end>;
 ov = 1; 
                <if_38_end>
            
            <if_36_end>
        
        <if_32_end>
    
    <if_31_end>
    r = (sa << 31) | rnum;
        if (ov != 1) goto <if_39_else>;
 ncc = 3; 
    goto <if_39_end>;
    <if_39_else>

                if (r != 0) goto <if_40_else>;
 ncc = 0; 
        goto <if_40_end>;
        <if_40_else>

                        if (sa != 1) goto <if_41_else>;
 ncc = 1; 
            goto <if_41_end>;
            <if_41_else>
 ncc = 2; 
            <if_41_end>
        
        <if_40_end>
    
    <if_39_end>
}

macro sra_core32(a, amt, r, ncc) {
    local sa:8;
    local num:8;
    local rnum:8;
    local mask31:8;
    sa = (a >> 31) & 1;
    num = a & 0x7fffffff;
    mask31 = 0x7fffffff;
        if (amt != 0) goto <if_42_else>;

        rnum = num;
    
    goto <if_42_end>;
    <if_42_else>

                if (!(amt > 30)) goto <if_43_else>;

            # Entire numeric part shifted out; result is -1 or 0
            # (PoP 7-441, note 2).
                        if (sa != 1) goto <if_44_else>;
 rnum = mask31; 
            goto <if_44_end>;
            <if_44_else>
 rnum = 0; 
            <if_44_end>
        
        goto <if_43_end>;
        <if_43_else>

            rnum = num >> amt;
                        if (sa != 1) goto <if_45_end>;

                rnum = rnum | ((mask31 << (31 - amt)) & mask31);
            
            <if_45_end>
        
        <if_43_end>
    
    <if_42_end>
    r = (sa << 31) | rnum;
        if (r != 0) goto <if_46_else>;
 ncc = 0; 
    goto <if_46_end>;
    <if_46_else>

                if (sa != 1) goto <if_47_else>;
 ncc = 1; 
        goto <if_47_end>;
        <if_47_else>
 ncc = 2; 
        <if_47_end>
    
    <if_46_end>
}

macro sla_core64(a, amt, r, ncc) {
    local sa:8;
    local num:8;
    local rnum:8;
    local out:8;
    local one:8;
    local allones:8;
    local ov:1;
    sa = (a >> 63) & 1;
    num = a & ((0x7FFFFFFF << 32) | 0xFFFFFFFF);
    ov = 0;
    one = 1;
        if (amt != 0) goto <if_48_else>;

        rnum = num;
    
    goto <if_48_end>;
    <if_48_else>

                if (!(amt > 62)) goto <if_49_else>;

            rnum = 0;
                        if (sa != 0) goto <if_50_else>;

                                if (num == 0) goto <if_51_end>;
 ov = 1; 
                <if_51_end>
            
            goto <if_50_end>;
            <if_50_else>

                                if (num == ((0x7FFFFFFF << 32) | 0xFFFFFFFF)) goto <if_52_end>;
 ov = 1; 
                <if_52_end>
            
            <if_50_end>
        
        goto <if_49_end>;
        <if_49_else>

            out = num >> (63 - amt);
            rnum = (num << amt) & ((0x7FFFFFFF << 32) | 0xFFFFFFFF);
            allones = (one << amt) - one;
                        if (sa != 0) goto <if_53_else>;

                                if (out == 0) goto <if_54_end>;
 ov = 1; 
                <if_54_end>
            
            goto <if_53_end>;
            <if_53_else>

                                if (out == allones) goto <if_55_end>;
 ov = 1; 
                <if_55_end>
            
            <if_53_end>
        
        <if_49_end>
    
    <if_48_end>
    r = (sa << 63) | rnum;
        if (ov != 1) goto <if_56_else>;
 ncc = 3; 
    goto <if_56_end>;
    <if_56_else>

                if (r != 0) goto <if_57_else>;
 ncc = 0; 
        goto <if_57_end>;
        <if_57_else>

                        if (sa != 1) goto <if_58_else>;
 ncc = 1; 
            goto <if_58_end>;
            <if_58_else>
 ncc = 2; 
            <if_58_end>
        
        <if_57_end>
    
    <if_56_end>
}

macro sra_core64(a, amt, r, ncc) {
    local sa:8;
    local num:8;
    local rnum:8;
    local mask63:8;
    sa = (a >> 63) & 1;
    num = a & ((0x7FFFFFFF << 32) | 0xFFFFFFFF);
    mask63 = ((0x7FFFFFFF << 32) | 0xFFFFFFFF);
